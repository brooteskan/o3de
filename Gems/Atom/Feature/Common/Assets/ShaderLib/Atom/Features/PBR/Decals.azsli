#include <Atom/Features/MatrixUtility.azsli>
#include <Atom/Features/BlendUtility.azsli>
#include <Atom/Feature/Common/Assets/Shaders/Materials/MaterialInputs/BaseColorInput.azsli>
#include <Atom/Features/Decals/DecalTextureUtil.azsli>
#include <Atom/RPI/TangentSpace.azsli>

#ifndef ENABLE_DECALS_CAP
#define ENABLE_DECALS_CAP 20 // Default cap if it was not set by the pipeline. This is only applicable if gpu culling is disabled
#endif

#if ENABLE_DECALS
 
real GetDecalAttenuation(real3 surfNormal, real3 decalUp, real decalAngleAttenutation)
{
    const half DecalClampAngle = 0.55;
    real dotAtten = dot(surfNormal, decalUp);
    dotAtten = clamp(dotAtten, DecalClampAngle, 1.0);
    dotAtten = smoothstep(DecalClampAngle, 1.0, dotAtten);
     
    return lerp(1, dotAtten, decalAngleAttenutation);
}

// Modes match DecalBlendMode. Operate on linear working-space surface color.
real3 BlendDecalColor(real3 base, real3 decal, uint mode)
{
    if (mode == 1) // Multiply
    {
        return base * decal;
    }
    if (mode == 2) // Add (bounded base-color reflectance)
    {
        return saturate(base + decal);
    }
    if (mode == 3) // Screen
    {
        return 1.0 - (1.0 - base) * (1.0 - decal);
    }
    if (mode == 4) // Overlay, selected by the underlying surface color
    {
        return TextureBlend_Overlay(base, decal);
    }
    return decal; // Alpha, also the fallback for unknown modes
}

void ApplyDecalData(Decal decal, inout Surface surface, float3 positionDx, float3 positionDy)
{

    real3x3 decalRot = MatrixFromQuaternion(real4(decal.m_quaternion));
    decalRot = transpose(decalRot);
    
    real3 localPos = real3(surface.position - decal.m_position);
    localPos = mul(decalRot, localPos);

    real3 decalUVW = localPos * rcp(real3(decal.m_halfSize));
    
    [branch]
    if(decalUVW.x >= -1.0 && decalUVW.x <= 1.0 &&
       decalUVW.y >= -1.0 && decalUVW.y <= 1.0 &&
       decalUVW.z >= -1.0 && decalUVW.z <= 1.0)
    {
        // [GFX TODO][ATOM-13798] Investigate using SampleGrad in the decal shader
        const uint textureArrayIndex = decal.m_textureArrayIndex;
        const uint textureIndex = decal.m_textureIndex;
        
        decalUVW.y *= -1;

        real3 decalUV = real3(decalUVW.xy * 0.5 + 0.5, textureIndex);
        float2 decalDx = mul(decalRot, positionDx).xy / decal.m_halfSize.xy * float2(.5, -.5);
        float2 decalDy = mul(decalRot, positionDy).xy / decal.m_halfSize.xy * float2(.5, -.5);
        
        float4 baseMap = 0;
        float2 normalMap = 0;
        // Each texture array handles a size permutation.
        // e.g. it could be that tex array 0 handles 256x256 and tex array 1 handles 512x64, etc.
        [branch]
        switch(textureArrayIndex)
        {
            case 0:
                baseMap = ViewSrg::m_decalTextureArrayDiffuse0.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy);
                normalMap = ViewSrg::m_decalTextureArrayNormalMaps0.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy).rg;
            break;
            case 1:
                baseMap = ViewSrg::m_decalTextureArrayDiffuse1.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy);
                normalMap = ViewSrg::m_decalTextureArrayNormalMaps1.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy).rg;
            break;
            case 2:
                baseMap = ViewSrg::m_decalTextureArrayDiffuse2.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy);
                normalMap = ViewSrg::m_decalTextureArrayNormalMaps2.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy).rg;
            break;
            case 3:
                baseMap = ViewSrg::m_decalTextureArrayDiffuse3.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy);
                normalMap = ViewSrg::m_decalTextureArrayNormalMaps3.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy).rg;
            break;
            case 4:
                baseMap = ViewSrg::m_decalTextureArrayDiffuse4.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy);
                normalMap = ViewSrg::m_decalTextureArrayNormalMaps4.SampleGrad(PassSrg::LinearSampler, decalUV, decalDx, decalDy).rg;
            break;            
        }
        
        const real decalAttenuation = GetDecalAttenuation(surface.GetVertexNormal(), decalRot[2], real(decal.m_angleAttenuation));
        const real albedoOpacity = real(baseMap.a) * real(decal.m_opacity) * decalAttenuation;

        bool useTexture = true;
        real3 blendedBaseColor = BlendBaseColor(real3(baseMap.rgb), real3(decal.m_decalColor), real(decal.m_decalColorFactor), TextureBlendMode::Multiply, useTexture);
        const uint blendMode = (decal.m_sortKeyPacked >> 8) & 0xFF;
        const real3 decalColor = BlendDecalColor(surface.albedo, real3(blendedBaseColor.rgb), blendMode);
        surface.albedo = lerp(surface.albedo, decalColor, albedoOpacity);

        const real normalOpacity = real(baseMap.a) * real(decal.m_normalMapOpacity) * decalAttenuation;
        const real3 normalMapWS = GetWorldSpaceNormal(real2(normalMap), decalRot[2], decalRot[0], decalRot[1], 1.0);
        surface.normal = normalize(lerp(surface.normal, normalMapWS, normalOpacity));
    }
}

#include <Atom/Features/PBR/DecalComposite.azsli>

void ApplyDecal(uint currDecalIndex, inout Surface surface)
{
    Decal decal = ViewSrg::m_decals[currDecalIndex];
    float3 positionDx=ddx(surface.position), positionDy=ddy(surface.position);
    if (((decal.m_sortKeyPacked >> 8) & 0xFF) == 5)
    {
        ApplyPaintComposite(decal, surface, positionDx, positionDy);
    }
    else
    {
        ApplyDecalData(decal, surface, positionDx, positionDy);
    }
}
#else
void ApplyDecal(inout LightCullingTileIterator tileIterator, inout Surface surface)
{
    //Not Enabled
}
#endif
